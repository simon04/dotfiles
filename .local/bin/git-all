#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///

import pathlib
import subprocess
import sys

dirs = sorted(
    dir
    for pattern in ("*/.git", "*/*/.git")
    for dir in pathlib.Path.cwd().glob(pattern, recurse_symlinks=True)
)

for dir in dirs:
    print()
    print(f"== {dir.parent} ==")
    subprocess.run(
        [
            "git",
            "--no-pager",
            "-C",
            dir.parent,
            *sys.argv[1:],
        ]
    )
