#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///

import pathlib
import subprocess
import sys

dirs = sorted(
    dir
    for pattern in ("*/.git", "*/*/.git")
    for dir in pathlib.Path.cwd().glob(pattern, recurse_symlinks=True)
)

for dir in dirs:
    print()
    print(f"== {dir.parent} ==")
    args = ["git", "--no-pager", *sys.argv[1:]]
    if len(sys.argv) > 1 and sys.argv[1].startswith("!"):
        args = [sys.argv[1].removeprefix("!"), *sys.argv[2:]]
    subprocess.run(args=args, cwd=dir.parent, check=False)
