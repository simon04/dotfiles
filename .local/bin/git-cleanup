#!/usr/bin/env python3
"""
Delete local branches that were merged upstream or whose remote branch is gone.

A branch is deleted if one of the following holds:

- it has no commits beyond the upstream branch (like `git branch --merged`),
- every commit beyond upstream has a Change-Id found in upstream (Gerrit merges
  a rebased version of a change, so the hashes differ),
- every commit beyond upstream has a patch-equivalent commit in upstream
  (`git cherry`, for rebase merges without Change-Ids),
- its remote-tracking branch is gone (e.g. deleted after a squash-merged PR).

Branches checked out in a worktree are kept.

Usage:
    git cleanup              # delete the merged branches
    git cleanup --dry-run    # only list them
"""

import argparse
import subprocess
import sys


def git(*args: str) -> str:
    return subprocess.run(
        ['git', *args], check=True, capture_output=True, text=True
    ).stdout.strip()


def default_upstream(remote: str) -> str:
    """The remote's default branch, e.g. origin/master."""
    try:
        return git('symbolic-ref', '--short', f'refs/remotes/{remote}/HEAD')
    except subprocess.CalledProcessError:
        for name in ('master', 'main'):
            ref = f'{remote}/{name}'
            if subprocess.run(
                ['git', 'rev-parse', '--verify', '--quiet', ref], capture_output=True
            ).returncode == 0:
                return ref
    sys.exit(f'Cannot determine the default branch of {remote}, use --upstream')


def change_ids(rev_range: str) -> list[str]:
    output = git('log', '--format=%(trailers:key=Change-Id,valueonly,separator=%x2C)', rev_range)
    return [cid.strip() for line in output.splitlines() for cid in line.split(',') if cid.strip()]


def branch_status(upstream: str, branch: str, track: str, merged_ids: set[str]) -> tuple[str, bool]:
    """A description of the branch's state and whether it can be deleted."""
    commits = int(git('rev-list', '--count', f'{upstream}..{branch}'))
    if commits == 0:
        return f'nothing beyond {upstream}', True
    if track == '[gone]':
        return 'remote branch gone', True

    ids = change_ids(f'{upstream}..{branch}')
    missing = [cid for cid in ids if cid not in merged_ids]
    if len(ids) == commits and not missing:
        return 'merged (Change-Id)', True

    cherry = git('cherry', upstream, branch).splitlines()
    if all(line.startswith('-') for line in cherry):
        return 'merged (patch-id)', True

    if ids and len(missing) < len(ids):
        return f'partially merged ({len(ids) - len(missing)}/{len(ids)})', False
    return 'unmerged', False


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--remote', default='origin', help='remote to compare with (default: origin)')
    parser.add_argument('--upstream', help="upstream branch (default: the remote's default branch)")
    parser.add_argument('--no-fetch', action='store_true', help="don't fetch the remote first")
    parser.add_argument('-n', '--dry-run', action='store_true', help='only list the merged branches')
    parser.add_argument('-v', '--verbose', action='store_true', help='also list unmerged branches')
    args = parser.parse_args()

    if not args.no_fetch:
        subprocess.run(['git', 'fetch', '--quiet', args.remote], check=True)
    upstream = args.upstream or default_upstream(args.remote)

    # All Change-Ids in the upstream branch, looked up once
    merged_ids = set(change_ids(upstream))
    upstream_name = upstream.split('/', 1)[-1]

    merged = []
    refs = git('for-each-ref', '--format=%(refname:short)%00%(upstream:track)%00%(worktreepath)', 'refs/heads/')
    for line in refs.splitlines():
        branch, track, worktree = line.split('\0')
        if branch == upstream_name:
            continue
        status, deletable = branch_status(upstream, branch, track, merged_ids)
        if deletable and worktree:
            status += f', checked out in {worktree}, kept'
            deletable = False
        if deletable:
            merged.append(branch)
        if deletable or args.verbose:
            print(f'{branch}: {status}')

    if not merged:
        print('No merged branches.')
    elif args.dry_run:
        print(f'\n{len(merged)} merged branch(es), run without --dry-run to delete them.')
    else:
        for branch in merged:
            # -D: Git doesn't consider rebased merges as merged
            git('branch', '-D', branch)
            print(f'Deleted {branch}')


if __name__ == '__main__':
    main()
